APP_ENV=docker

# --- MongoDB: 1 database = 1 bounded context (6 instance, tanpa proxy) ---
# Host = nama service mongo_* di docker-compose.yml, port 27017 = port mongod di
# dalam network compose. Tidak ada kredensial (Mongo tanpa auth di dev).
MONGO_IDENTITY_HOST=mongo_identity
MONGO_IDENTITY_PORT=27017
MONGO_IDENTITY_DB=ec_identity
MONGO_MERCHANT_HOST=mongo_merchant
MONGO_MERCHANT_PORT=27017
MONGO_MERCHANT_DB=ec_merchant
MONGO_CATALOG_HOST=mongo_catalog
MONGO_CATALOG_PORT=27017
MONGO_CATALOG_DB=ec_catalog
MONGO_SALES_HOST=mongo_sales
MONGO_SALES_PORT=27017
MONGO_SALES_DB=ec_sales
MONGO_EXPERIENCE_HOST=mongo_experience
MONGO_EXPERIENCE_PORT=27017
MONGO_EXPERIENCE_DB=ec_experience
MONGO_EMAIL_HOST=mongo_email
MONGO_EMAIL_PORT=27017
MONGO_EMAIL_DB=ec_email


SECRET_KEY=k8s-fase8-local-9f3a7c1e5b2d8a4f6c0e3b7d1a5f9c2e

